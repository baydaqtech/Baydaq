APP_NAME="Baydaq Tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail goes to the log (or MAIL_MAILER=smtp with Sail's mailpit on port 1025).
# Production (Laravel Cloud): MAIL_MAILER=ses-v2 with the SES_* keys below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SES_KEY=
SES_SECRET=
SES_REGION=me-south-1
# Set once the "baydaq-platform" tenant exists in SES.
SES_TENANT=

# Object storage. Logos use LOGO_DISK: "public" locally (run php artisan storage:link),
# "s3" on Laravel Cloud with a public bucket attached (Cloud fills in the AWS_* values).
LOGO_DISK=public
# Employee files: "hr" (local, private) or "hr-s3" on Laravel Cloud. HR_BUCKET defaults to AWS_BUCKET.
HR_DISK=hr
# Separate secret used to hash national ids for search; generate with: php -r "echo bin2hex(random_bytes(32));"
HR_BLIND_INDEX_KEY=
# Handover and incident photos: "assets" (local, private) or "assets-s3" on Laravel Cloud. ASSETS_BUCKET defaults to AWS_BUCKET.
ASSETS_DISK=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker (compose.yaml)
WWWUSER=1000
WWWGROUP=1000
APP_PORT=8090
VITE_PORT=5180
FORWARD_DB_PORT=3310
FORWARD_MAILPIT_PORT=1030
FORWARD_MAILPIT_DASHBOARD_PORT=8030

# First system admin, created by php artisan db:seed (must change the password at first sign-in).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
